+// Only the isolated experiment binary accepts these controls.
+using GroupWindows = std::map<std::string, Detection::Windows>;
+GroupWindows read_donor(const char *path) {
+    GroupWindows donor;
+    std::ifstream input(path);
+    if (!input) throw std::runtime_error("Cannot read donor windows");
+    std::string key;
+    int side, face;
+    Rect r;
+    while (input >> key >> side >> face >> r.u.lo >> r.u.hi >> r.v.lo >> r.v.hi) {
+        if (!donor[key].at(side).emplace(face, r).second)
+            throw std::runtime_error("Duplicate donor face");
+    }
+    if (!input.eof() || donor.empty()) throw std::runtime_error("Invalid donor file");
+    return donor;
+}
