+namespace nc::audit {
+extern thread_local int reason;
+struct NativeStats {
+    struct Cell {std::atomic<long long> calls{}, finished{}, hits{}, ns{};};
+    Cell data[2][15];
+    struct Comparison {std::atomic<long long> calls{}, resolved{}, discordant{}, direct_ns{}, resolved_native_ns{};};
+    Comparison cohort[2];
+    ~NativeStats() {
+        for (int site=0;site<2;++site) {
+            const auto& c=cohort[site];
+            std::fprintf(stderr,"uv_cohort %d %lld %lld %lld %lld %lld\n",site,c.calls.load(),c.resolved.load(),
+                         c.discordant.load(),c.direct_ns.load(),c.resolved_native_ns.load());
+        }
+        for (int site=0;site<2;++site) for (int k=0;k<15;++k) {
+            const auto& c=data[site][k];
+            if (c.calls.load()) std::fprintf(stderr,"native_fallback %d %d %lld %lld %lld %lld\n",
+                site,k,c.calls.load(),c.finished.load(),c.hits.load(),c.ns.load());
+        }
+    }
+} native;
+template<class Ray> long long perform(int site,Ray& ray,const gp_Lin& line,double first,double last) {
+    auto& c=native.data[site][reason];
+    ++c.calls;
+    const auto start=std::chrono::steady_clock::now();
+    ray->Perform(line,first,last);
+    const auto ns=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-start).count();
+    c.ns+=ns;
+    if (ray->IsDone()) {
+        ++c.finished;
+        if (ray->NbPnt()) ++c.hits;
+    }
+    return ns;
+}
+}

