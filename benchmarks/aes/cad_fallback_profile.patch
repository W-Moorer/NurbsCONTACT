 #include <map>
 #include <numeric>
 #include <stdexcept>
+
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+
+namespace nc::audit {
+extern thread_local int reason;
+struct NativeStats {
+    struct Cell {std::atomic<long long> calls{}, finished{}, hits{}, ns{};};
+    Cell data[2][15];
+    ~NativeStats() {
+        for (int site=0;site<2;++site) for (int k=0;k<15;++k) {
+            const auto& c=data[site][k];
+            if (c.calls.load()) std::fprintf(stderr,"native_fallback %d %d %lld %lld %lld %lld\n",
+                site,k,c.calls.load(),c.finished.load(),c.hits.load(),c.ns.load());
+        }
+    }
+} native;
+template<class Ray> void perform(int site,Ray& ray,const gp_Lin& line,double first,double last) {
+    auto& c=native.data[site][reason];
+    ++c.calls;
+    const auto start=std::chrono::steady_clock::now();
+    ray->Perform(line,first,last);
+    c.ns+=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-start).count();
+    if (ray->IsDone()) {
+        ++c.finished;
+        if (ray->NbPnt()) ++c.hits;
+    }
+}
+}

